{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nautilus:schema:extended-world:1",
  "title": "Nautilus sparse extended world v1 candidate",
  "description": "Engine-owned native metre contract: x/y horizontal, h vertical. Structural constraints only: openWorld also checks global unique IDs, contiguous floor indices, increasing elevations, world bounds, support and traversal references, actor landings, finite values and an 8,000,000 UTF-8 byte budget. This is not aft-map-v2 or aft-block-v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "name", "profileId", "bounds", "floors", "surfaces", "entities", "links"],
  "properties": {
    "kind": {"const": "nautilus-extended-world"},
    "version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 96},
    "profileId": {"const": "native-metres-v1"},
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["widthM", "depthM", "minHeightM", "heightM"],
      "properties": {
        "widthM": {"type": "number", "minimum": 0.001, "maximum": 4096},
        "depthM": {"type": "number", "minimum": 0.001, "maximum": 4096},
        "minHeightM": {"type": "number", "minimum": -2048, "maximum": 0, "description": "Explicit lower geometry bound; negative playable floor positions are unsupported."},
        "heightM": {"type": "number", "minimum": 0.001, "maximum": 2048, "description": "Absolute upper geometry height from the shared datum, not a floor index."}
      }
    },
    "floors": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/floor"}},
    "surfaces": {"type": "array", "maxItems": 32768, "items": {"$ref": "#/$defs/surface"}},
    "entities": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/entity"}},
    "links": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/link"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}(?![\\s\\S])", "minLength": 1, "maxLength": 96},
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "h"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 4096},
        "y": {"type": "number", "minimum": 0, "maximum": 4096},
        "h": {"type": "number", "minimum": -2048, "maximum": 2048}
      }
    },
    "aabb": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/$defs/point"}, "max": {"$ref": "#/$defs/point"}}
    },
    "floor": {
      "type": "object", "additionalProperties": false, "required": ["id", "index", "label", "elevationM"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "index": {"type": "integer", "minimum": 0, "maximum": 31},
        "label": {"type": "string", "minLength": 1, "maxLength": 36},
        "elevationM": {"type": "number", "minimum": 0, "maximum": 2048}
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "floorId", "role", "bounds", "supports", "supportFloorId"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "floorId": {"$ref": "#/$defs/id"},
        "role": {"enum": ["floor", "roof", "solid"]}, "bounds": {"$ref": "#/$defs/aabb"},
        "supports": {"type": "boolean"}, "supportFloorId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "landing": {
      "type": "object", "additionalProperties": false, "required": ["floorId", "surfaceId", "position"],
      "properties": {"floorId": {"$ref": "#/$defs/id"}, "surfaceId": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/point"}}
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "content", "floorId", "position", "yawRadians", "supportSurfaceId"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["actor", "content"]},
        "content": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1, "maxLength": 96}}
        },
        "floorId": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/point"},
        "yawRadians": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793},
        "supportSurfaceId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "from", "to", "bidirectional"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["stairs", "ladder", "ramp"]},
        "from": {"$ref": "#/$defs/landing"}, "to": {"$ref": "#/$defs/landing"}, "bidirectional": {"type": "boolean"}
      }
    }
  }
}
