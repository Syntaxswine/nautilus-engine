{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nautilus:schema:farmyard-window-host-save:1",
  "title": "Complete retained Farmyard pane host save v1",
  "description": "Closed joint envelope, complete pane journal and geometry plus bounded retained source JSON. Fields marked in setFields encode lossless native sets: seen/visible contain unique canonical coordinate keys; detected contains unique typed actor IDs. Unmarked arrays preserve ordinary duplicates and order. The executable adapter additionally checks safe coordinate integers, resource presence, pane/sequence/content agreement, semantic conflicts and aggregate budgets. The versioned host save service validates game-specific meaning before adoption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "geometry",
    "windowState",
    "sequenceOrigin",
    "source",
    "setFields"
  ],
  "properties": {
    "kind": {
      "const": "nautilus-farmyard-window-host-save"
    },
    "version": {
      "const": 1
    },
    "geometry": {
      "$ref": "urn:nautilus:schema:window-geometry:1"
    },
    "windowState": {
      "$ref": "urn:nautilus:schema:window-pane-state:1"
    },
    "sequenceOrigin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "setFields": {
      "type": "array",
      "items": {
        "enum": [
          "seen",
          "visible",
          "detected"
        ]
      },
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "setFields"
        ],
        "properties": {
          "setFields": {
            "contains": {
              "const": "seen"
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "seen": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/fogCell"
                },
                "maxItems": 65536,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "setFields"
        ],
        "properties": {
          "setFields": {
            "contains": {
              "const": "visible"
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "visible": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/fogCell"
                },
                "maxItems": 65536,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "setFields"
        ],
        "properties": {
          "setFields": {
            "contains": {
              "const": "detected"
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "detected": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/actorId"
                },
                "maxItems": 65536,
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fogCell": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^(0|-?[1-9][0-9]*),(0|-?[1-9][0-9]*)(?![\\s\\S])",
      "description": "Source.key(x,y) canonical integer coordinate string; executable loading also checks safe integer headroom."
    },
    "actorId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*(?![\\s\\S])"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "data": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 65536
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "const": "__proto__"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/data"
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/data"
      },
      "required": [
        "id",
        "team",
        "hp",
        "ap",
        "stamina",
        "maxHp",
        "maxAp",
        "maxStamina",
        "x",
        "y",
        "ammo",
        "pack"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/actorId"
        },
        "team": {
          "enum": [
            "squad",
            "guard"
          ]
        },
        "hp": {
          "type": "number"
        },
        "ap": {
          "type": "number"
        },
        "stamina": {
          "type": "number"
        },
        "maxHp": {
          "type": "number"
        },
        "maxAp": {
          "type": "number"
        },
        "maxStamina": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "const": 0
        },
        "ammo": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/data"
          }
        },
        "pack": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 65536
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/data"
      },
      "required": [
        "map",
        "edges",
        "windows",
        "windowBreaks",
        "windowSequence",
        "revision",
        "seed",
        "elapsed",
        "queue",
        "log",
        "interactables",
        "units",
        "solo",
        "seen",
        "visible",
        "detected"
      ],
      "properties": {
        "map": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 240
          },
          "maxItems": 240
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/data"
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 1024
        },
        "windowBreaks": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^r[01]c[012](?![\\s\\S])"
            },
            "maxItems": 6,
            "uniqueItems": true
          }
        },
        "windowSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seed": {
          "type": "number"
        },
        "elapsed": {
          "type": "number"
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 65536
        },
        "log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 65536
        },
        "interactables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 65536
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          },
          "maxItems": 128
        },
        "solo": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/data"
          },
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "const": 2
            }
          }
        },
        "seen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 65536
        },
        "visible": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 65536
        },
        "detected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data"
          },
          "maxItems": 65536
        }
      }
    }
  }
}
