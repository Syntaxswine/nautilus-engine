      "dom": "<body data-last-menu-error=\"start\"><header class=\"study-header\"><a href=\"../\">N <span>NAUTILUS <small>GAME SYSTEM STUDIES / 04</small></span></a><a href=\"../docs/asset-handoffs.md\">Use these systems ↗</a></header>\n<main><div id=\"title-mount\"></div>\n<section id=\"game\" aria-labelledby=\"yard-title\" hidden=\"\"><div class=\"yard-heading\"><div><p class=\"eyebrow\">THE THRESHOLD YARD</p><h1 id=\"yard-title\">A way through.</h1><p>Open the gate. Cross the yard. Take the stairs to the deck.</p></div><button id=\"menu\">Main menu</button></div>\n<div class=\"yard-layout\"><section class=\"scene-panel\"><svg id=\"yard\" viewBox=\"0 0 640 410\" tabindex=\"0\" role=\"img\" aria-label=\"Practice yard with a gate, two floors and a stair flight. Focus here and use arrow keys to walk.\"><rect x=\"0\" y=\"0\" width=\"640\" height=\"410\" fill=\"#15362e\"></rect><polygon points=\"260,55 568,223 348,343 40,175\" fill=\"#315340\" stroke=\"#78906a\" stroke-width=\"1.2\"></polygon><path d=\"M260 55L40 175\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M282 67L62 187\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M304 79L84 199\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M326 91L106 211\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M348 103L128 223\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M370 115L150 235\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M392 127L172 247\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M414 139L194 259\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M436 151L216 271\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M458 163L238 283\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M480 175L260 295\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M502 187L282 307\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M524 199L304 319\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=\"M546 211L326 331\" stroke=\"#b7bd8733\" fill=\"none\"></path><path d=