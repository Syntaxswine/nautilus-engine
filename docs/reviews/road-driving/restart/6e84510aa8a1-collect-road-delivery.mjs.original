import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';
const root=process.cwd(),dest=path.join(root,'docs/reviews/road-driving'),sha=b=>createHash('sha256').update(b).digest('hex'),read=p=>JSON.parse(fs.readFileSync(p)),git=args=>execFileSync('git',args,{encoding:'utf8',windowsHide:true}).trim(),head=git(['rev-parse','HEAD']),tree=git(['rev-parse','HEAD^{tree}']);
const installation=read('artifacts/road-installed/latest.json'),source=read('artifacts/road-yard-review/browser.json'),installed=read('artifacts/road-yard-installed-review/browser.json'),preview=read('artifacts/road-default-built-review/browser.json'),equal=read('artifacts/road-ci-payload-equality.json'),helpers=read('artifacts/road-helper-lifetimes.json'),helperAudit=read('artifacts/road-helper-verification.json'),gates=read('artifacts/road-final-gates.json');
assert.equal(installation.status,'fixed-installed');assert.equal(installation.engineSource.commit,head);assert.equal(installation.engineSource.dirty,false);assert.equal(source.source,head);assert.equal(installed.source,head);assert.equal(preview.provenance.source.commit,head);assert.equal(preview.provenance.source.dirty,false);assert.equal(preview.query,'');assert.equal(preview.status,'passed');assert.equal(source.results.length,20);assert.equal(installed.results.length,20);assert.equal(installation.engineSource.payloadSHA256,equal.payloadSHA256);assert.equal(installation.allInstalledBytesVerified,true);assert.ok(Object.values(gates).every(g=>g.exitCode===0));
assert.equal(helperAudit.retainedHelpers.length,0);assert.equal(helperAudit.lifetimes.length,helpers.length);assert.ok(helperAudit.lifetimes.every(r=>r.identities.every(i=>i.originalExited)&&r.originalListenerAbsent&&r.receipt.httpClosed&&r.receipt.browserClosed));
const copies=[];const copy=(from,to)=>{assert.ok(fs.statSync(from).isFile(),from);const target=path.join(dest,to);fs.mkdirSync(path.dirname(target),{recursive:true});fs.copyFileSync(from,target);const b=fs.readFileSync(target);copies.push({path:to,bytes:b.length,sha256:sha(b),from});};
copy('artifacts/road-review-README.md','README.md');
for(const [from,to] of [['road-yard-review','source'],['road-yard-installed-review','installed'],['road-default-built-review','default-preview']]){for(const entry of fs.readdirSync(path.join('artifacts',from)))if(entry==='browser.json'||entry.endsWith('.png'))copy(path.join('artifacts',from,entry),to+'/'+entry);}
copy('artifacts/road-installed/latest.json','installed/package.json');
copy('artifacts/road-ci-payload-equality.json','gates/runtime-payload-equality.json');copy('artifacts/road-index.json','gates/index.json');
for(const [from,to]of [['road-ci-correction-check.log','check.log'],['road-ci-correction-tests.log','tests.log'],['road-ci-correction-upstream.log','upstream.log'],['road-final-clean-build.log','build.log']])copy('artifacts/'+from,'gates/'+to);
copy('artifacts/road-costs/costs.json','visual/costs.json');for(const name of ['browser.json','contact-full.png','contact-game.png'])copy('artifacts/road-library-review/'+name,'visual/'+name);
copy('artifacts/player-setup-yard-built/browser.json','regressions/trains.json');copy('artifacts/night-ledger-review/browser.json','regressions/night-ledger-browser.json');copy('artifacts/night-ledger-focused/checks.json','regressions/night-ledger-node-types.json');copy('artifacts/night-ledger-installed/latest.json','regressions/night-ledger-installation.json');
const artwork=read('artifacts/shared-artwork-package/latest.json');assert.equal(artwork.status,'pass');copy(artwork.report,'gates/shared-artwork-package.json');
const editor=[];for(const [folder,name]of [['tile-stack-editor-installed','stack'],['editor-tile-authoring-c1-installed','authoring']]){const file='artifacts/'+folder+'/review.json',r=read(file);assert.equal(r.status,'pass');assert.equal(r.checks.length,r.requiredChecks.length);assert.equal(r.installation.stageRemoved,true);editor.push({name,status:r.status,checks:r.checks.length,captures:r.captures.length,fullReportSHA256:sha(fs.readFileSync(file)),source:file,packages:r.installation.packages,allFileBytesVerified:true,stageRemoved:true});}
const save=(file,value)=>{const target=path.join(dest,file);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,JSON.stringify(value,null,2)+'\n');const b=fs.readFileSync(target);copies.push({path:file,bytes:b.length,sha256:sha(b)});};save('gates/installed-editors.json',editor);
copy('artifacts/road-helper-lifetimes.json','lifecycle/lifetimes.json');copy('artifacts/road-helper-verification.json','lifecycle/verification.json');
const tracked=new Set(git(['ls-files']).split('\n')),restartFiles=[];for(const file of new Set([...helpers.flatMap(h=>h.sourceFiles||[]),'artifacts/collect-road-helpers.mjs','artifacts/verify-road-helpers.ps1','artifacts/verify-road-index.mjs','artifacts/collect-road-delivery.mjs'])){if(tracked.has(file))continue;assert.ok(file.startsWith('artifacts/'),file);const full=fs.realpathSync(file);assert.ok(full.startsWith(root+path.sep),file);const bytes=fs.readFileSync(full),to='restart/'+sha(bytes).slice(0,12)+'-'+path.basename(file)+'.original';copy(file,to);restartFiles.push({originalPath:file,preservedPath:to,sha256:sha(bytes),bytes:bytes.length});}
save('restart/records.json',{sourceCommit:head,cwd:root,files:restartFiles,helpers:helpers.map(h=>({owner:h.owner,purpose:h.purpose,sourceFiles:h.sourceFiles,restart:h.restart})),note:'Restore preserved scripts to their original artifacts paths and deliberately invoke the recorded command after checking the source/build pin. No command is automatically replayed; all disposable lifetimes have exited. Versioned scripts and package inputs are preserved by source commit and payload hashes.'});
save('lifecycle/artwork-package-children.json',{runId:artwork.runId,cleanup:read(artwork.report).cleanup,commands:read(artwork.report).commands});
const ledger=read('docs/reviews/road-driving/registration.json'),report={version:1,status:'finished candidate for Architect review',createdAt:new Date().toISOString(),base:ledger.base,art:ledger.art,implementationCommit:head,implementationTree:tree,originalRuntimeCommit:equal.priorCommit,runtimePayloadSHA256:equal.payloadSHA256,package:installation.package,source:installation.engineSource,allInstalledBytesVerified:installation.allInstalledBytesVerified,registration:{path:'registration.json',sha256:sha(fs.readFileSync('docs/reviews/road-driving/registration.json')),sourceFiles:ledger.files.length,adaptedFiles:ledger.adapted.length},launch:{path:'/examples/vehicle-yard/',query:'',normalClock:true,ordinaryContextualActionsAndJoystick:true,buildCommit:preview.provenance.source.commit,retainedService:false,previewOwnerAfterApproval:'Architect, Nautilus Engine'},checks:{gates,sourceBrowserGroups:20,installedBrowserGroups:20,installedHeadlessBodies:installation.node.bodyProofs.length,publicTypeNegativeControls:installation.types.negativeControls,visualCombinations:48,realTrainCircuitBrowserGroups:read('artifacts/player-setup-yard-built/browser.json').groups.length,nightLedgerNodeTests:read('artifacts/night-ledger-focused/checks.json').tests,nightLedgerBrowserGroups:read('artifacts/night-ledger-review/browser.json').groups.length,installedEditorWorkflows:editor.map(({name,checks,captures,status})=>({name,status,checks,captures})),installedArtworkProfiles:read(artwork.report).profiles.map(p=>p.profile)},provenanceLimits:['Regression train and Night Ledger proofs use the earlier fixed runtime commit recorded in their evidence; every one of its 555 payload files equals this final implementation package.','The gallery covers unchanged approved art/derivative bytes; captures do not establish GPU timing or handset FPS.','Mixed-component vehicle proof uses an inactive train UI contract fixture; real two-circuit train simulation has its separate proof.'],helpers:{launchedBy:'01a1810c-62da-7210-a1ca-b72b449ce024',lifetimes:helpers.length,originalIdentitiesExited:true,originalListenersAbsent:true,retained:0},limitations:['Flat low-speed kinematic course only; conservative turning envelopes may refuse narrow clearances early.','No non-flat terrain, tire/suspension model, crashes, fuel, damage or AI.','No game consumer pin update or adoption claim.'],evidence:copies};
fs.writeFileSync(path.join(dest,'delivery.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({status:report.status,implementationCommit:head,evidenceFiles:copies.length,bytes:copies.reduce((n,f)=>n+f.bytes,0),helpers:helpers.length}));
