import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {execFileSync} from 'node:child_process';
import {withArtReview} from '../tools/art-review-browser.mjs';
import {requireVehicleMotion} from '../tools/vehicle-workflow.mjs';
const expectedPin=process.argv[2]||execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
await withArtReview('Clean static road-yard default page: ordinary joystick board, forward, reverse, stop and exit',async({page,baseURL,out})=>{
 page.setDefaultTimeout(30000);
 const requested=[];page.on('request',r=>{if(r.url().startsWith(baseURL))requested.push(new URL(r.url()).pathname);});
 await page.goto(baseURL+'/examples/vehicle-yard/');
 await page.waitForFunction(()=>window.vehicleYard,{timeout:90000});
 assert.equal(new URL(page.url()).search,'');
 const read=()=>page.evaluate(()=>{const y=vehicleYard,s=y.host.connector.readForActor('player');return {mode:s.mode,vehicle:s.vehicle,lease:s.lease,actor:y.host.read().actor,resources:y.host.read().resources,visible:y.surface.scene.getObjectByName('Native actor player')?.visible};});
 const provenance=await page.evaluate(async()=>fetch('/package-provenance.json').then(r=>r.json()));
 assert.equal(provenance.source.commit,expectedPin);assert.equal(provenance.source.dirty,false);
 const onFoot=await read();assert.equal(onFoot.mode,'on-foot');assert.equal(onFoot.visible,true);
 await page.getByRole('button',{name:'Enter Compact hatchback · driver',exact:true}).click();
 await page.waitForFunction(()=>vehicleYard.host.readPose().mode==='driver'&&vehicleYard.surface.scene.getObjectByName('Native actor player')?.visible===false);
 const before=await read();assert.equal(before.visible,false);
 const box=await page.getByRole('application',{name:/Car joystick/}).boundingBox(),x=box.x+box.width/2,y=box.y+box.height/2;
 await page.mouse.move(x,y);await page.mouse.down();await page.mouse.move(x,y-box.height*.29);
 await page.waitForFunction(()=>vehicleYard.host.connector.read().vehicles[0].position.y>7.7);
 const forward=await read();requireVehicleMotion(before,forward);
 await page.screenshot({path:path.join(out,'default-forward.png')});
 await page.mouse.move(x,y+box.height*.29);
 await page.waitForFunction(()=>vehicleYard.host.connector.read().vehicles[0].speedMps<0);
 const reverseStart=await read();
 await page.waitForFunction(y=>vehicleYard.host.connector.read().vehicles[0].position.y<y-.35,reverseStart.vehicle.position.y);
 const reverse=await read();requireVehicleMotion(reverseStart,reverse,{direction:-1});
 await page.screenshot({path:path.join(out,'default-reverse.png')});
 await page.mouse.up();await page.waitForFunction(()=>vehicleYard.host.connector.read().vehicles[0].speedMps===0);
 const stopped=await read();assert.equal(stopped.lease,null);
 await page.getByRole('button',{name:'Exit Compact hatchback',exact:true}).click();
 await page.waitForFunction(()=>vehicleYard.host.readPose().mode==='on-foot'&&vehicleYard.surface.scene.getObjectByName('Native actor player')?.visible===true);
 const exited=await read();assert.equal(exited.visible,true);assert.deepEqual(exited.resources,onFoot.resources);
 await page.screenshot({path:path.join(out,'default-safe-exit.png')});
 await page.evaluate(()=>vehicleYard.dispose());
 const report={status:'passed',launchPath:'/examples/vehicle-yard/',query:'',normalHostClock:true,ordinaryMouseJoystick:true,provenance,onFoot,before,forward,reverseStart,reverse,stopped,exited,requests:[...new Set(requested)].sort()};
 fs.writeFileSync(path.join(out,'browser.json'),JSON.stringify(report,null,2));
 console.log(JSON.stringify({status:report.status,launchPath:report.launchPath,source:provenance.source}));
},{source:false,owner:'01a1810c-62da-7210-a1ca-b72b449ce024',output:'road-default-built-review',timeoutMs:180000});
