import fs from 'node:fs';import path from 'node:path';import {withArtReview} from '../tools/art-review-browser.mjs';
await withArtReview('Reproduce held-key autorepeat across pause',async({page,baseURL,out})=>{await page.goto(baseURL+'/examples/vehicle-yard/?manual=1&contentPin=0000000000000000000000000000000000000000');await page.waitForFunction(()=>window.vehicleYard);await page.getByRole('button',{name:'Enter Compact hatchback · driver',exact:true}).click();await page.getByRole('application',{name:/Car joystick/}).focus();await page.keyboard.down('ArrowUp');await page.evaluate(()=>{for(let i=0;i<10;i++)vehicleYard.step(.05);vehicleYard.setup.ui.openMenu();vehicleYard.setup.ui.closeMenu();window.repeatSeen=null;addEventListener('keydown',e=>{window.repeatSeen=e.repeat;},{once:true});});const released=await page.evaluate(()=>vehicleYard.host.connector.readForActor('player').lease);await page.keyboard.down('ArrowUp');await page.evaluate(()=>{for(let i=0;i<20;i++)vehicleYard.step(.05);});const observed=await page.evaluate(()=>({repeat:repeatSeen,lease:vehicleYard.host.connector.readForActor('player').lease,speed:vehicleYard.host.connector.read().vehicles[0].speedMps}));await page.keyboard.up('ArrowUp');await page.evaluate(()=>vehicleYard.dispose());const result={released,observed};fs.writeFileSync(path.join(out,'repeat.json'),JSON.stringify(result,null,2));console.log(JSON.stringify(result));},{source:true,owner:'01a1810c-62da-7210-a1ca-b72b449ce024',output:'road-repeat-repro',timeoutMs:120000});
