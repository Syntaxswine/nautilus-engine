$taskRecords = Get-Content -LiteralPath 'artifacts/road-helper-lifetimes.json' -Raw | ConvertFrom-Json
$taskResults = foreach ($taskRecord in $taskRecords) {
  $taskIdentities = foreach ($taskIdentity in @($taskRecord.process, $taskRecord.browser)) {
    $taskProcess = Get-Process -Id $taskIdentity.pid -ErrorAction SilentlyContinue
    $taskSameLifetime = $false
    $taskIdentityError = $null
    if ($null -ne $taskProcess) {
      try { $taskSameLifetime = $taskProcess.StartTime.ToUniversalTime().ToFileTimeUtc().ToString() -eq $taskIdentity.creationFiletime }
      catch { $taskIdentityError = $_.Exception.Message }
    }
    [pscustomobject]@{pid=$taskIdentity.pid;creationFiletime=$taskIdentity.creationFiletime;executable=$taskIdentity.executable;originalExited=($null -eq $taskProcess -or (-not $taskSameLifetime -and $null -eq $taskIdentityError));pidReused=($null -ne $taskProcess -and -not $taskSameLifetime -and $null -eq $taskIdentityError);identityError=$taskIdentityError}
  }
  $taskListeners = @(Get-NetTCPConnection -State Listen -LocalPort $taskRecord.port -ErrorAction SilentlyContinue)
  [pscustomobject]@{folder=$taskRecord.folder;purpose=$taskRecord.purpose;owner=$taskRecord.owner;port=$taskRecord.port;startedAt=$taskRecord.startedAt;expiresAt=$taskRecord.expiresAt;identities=$taskIdentities;receipt=$taskRecord.receipt;originalListenerAbsent=(@($taskListeners | Where-Object {$_.OwningProcess -eq $taskRecord.process.pid}).Count -eq 0);portCurrentlyFree=($taskListeners.Count -eq 0);method='Read-only exact PID/creation-time and listener verification; no process was terminated by this audit.'}
}
$taskReport = [pscustomobject]@{version=1;checkedAt=(Get-Date).ToUniversalTime().ToString('o');lifetimes=@($taskResults);retainedHelpers=@()}
[System.IO.File]::WriteAllText((Join-Path (Get-Location) 'artifacts/road-helper-verification.json'), ($taskReport | ConvertTo-Json -Depth 14), [System.Text.UTF8Encoding]::new($false))
$taskUnresolved = @($taskResults | Where-Object { @($_.identities | Where-Object {-not $_.originalExited}).Count -gt 0 -or -not $_.originalListenerAbsent -or -not $_.receipt.httpClosed -or -not $_.receipt.browserClosed })
[pscustomobject]@{lifetimes=@($taskResults).Count;unresolved=$taskUnresolved.Count;retained=0} | ConvertTo-Json -Compress
if ($taskUnresolved.Count -gt 0) { exit 1 }
