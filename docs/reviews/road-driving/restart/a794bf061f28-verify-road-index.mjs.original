import fs from 'node:fs';import {execFileSync} from 'node:child_process';import {createHash} from 'node:crypto';
const sha=b=>createHash('sha256').update(b).digest('hex'),manifest='docs/reviews/road-driving/registration.json',m=JSON.parse(fs.readFileSync(manifest)),rows=[...m.files,...m.adapted,...[manifest,'tools/vehicle-registration.mjs'].map(path=>{const b=fs.readFileSync(path);return {path,bytes:b.length,sha256:sha(b)};})];
const output=execFileSync('git',['cat-file','--batch'],{input:rows.map(r=>':'+r.path+'\n').join(''),windowsHide:true,timeout:60000,maxBuffer:128*1024*1024});let at=0;
for(const r of rows){const end=output.indexOf(10,at),header=output.subarray(at,end).toString(),match=header.match(/^[a-f0-9]{40} blob ([0-9]+)$/);if(!match)throw Error('Indexed file unavailable: '+r.path);const size=Number(match[1]),bytes=output.subarray(end+1,end+1+size);if(size!==r.bytes||sha(bytes)!==r.sha256)throw Error('Staged byte mismatch: '+r.path);at=end+1+size+1;}
const report={version:1,status:'passed',files:rows.length,bytes:rows.reduce((n,r)=>n+r.bytes,0),sourceManifestSHA256:sha(fs.readFileSync(manifest)),method:'One read-only git cat-file batch; exact indexed size/SHA256 versus every new/adapted source row, guard and source ledger.'};fs.writeFileSync('artifacts/road-index.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report));
