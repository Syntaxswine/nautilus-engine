import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {execFileSync} from 'node:child_process';import {createHash} from 'node:crypto';
const root=process.cwd(),base='docs/reviews/road-chase-steering/',read=p=>JSON.parse(fs.readFileSync(p)),sha=b=>createHash('sha256').update(b).digest('hex'),git=args=>execFileSync('git',args,{encoding:'utf8',windowsHide:true}).trim(),head=git(['rev-parse','HEAD']),tree=git(['rev-parse','HEAD^{tree}']);
assert.equal(git(['status','--porcelain']),'','Collect from the clean committed implementation before adding evidence.');
const installation=read('artifacts/road-installed/latest.json'),candidate=read('artifacts/chase-candidate-installation.json'),gates=read('artifacts/chase-final-gates.json'),lifetimes=read('artifacts/chase-helper-lifetimes.json'),audit=read('artifacts/chase-helper-verification.json'),ledger=read(base+'registration.json');
assert.equal(installation.status,'fixed-installed');assert.equal(installation.engineSource.commit,head);assert.equal(installation.engineSource.dirty,false);assert.equal(installation.allInstalledBytesVerified,true);assert.equal(installation.engineSource.payloadSHA256,candidate.engineSource.payloadSHA256);assert.equal(installation.package.files,555);assert.equal(installation.node.bodyProofs.length,8);assert.equal(installation.types.negativeControls,9);assert.ok(Object.values(gates).every(g=>g.exitCode===0));
assert.equal(audit.lifetimes.length,lifetimes.length);assert.equal(audit.retainedHelpers.length,0);assert.ok(audit.lifetimes.every(r=>r.identities.every(i=>i.originalExited)&&r.originalListenerAbsent&&r.receipt.httpClosed&&r.receipt.browserClosed));
const evidence=[];function copy(from,to){const b=fs.readFileSync(from),bytes=/\.(?:json|md|log|mjs|ps1)(?:\.original)?$/.test(to)?Buffer.from(b.toString('utf8').replaceAll('\r\n','\n')):b,target=base+to;fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,bytes);evidence.push({path:to,bytes:bytes.length,sha256:sha(bytes),source:from,...(!bytes.equals(b)?{textLineEndings:'LF'}:{})});}
function save(to,data){const p=base+to;fs.mkdirSync(path.dirname(p),{recursive:true});const b=Buffer.from(JSON.stringify(data,null,2)+'\n');fs.writeFileSync(p,b);evidence.push({path:to,bytes:b.length,sha256:sha(b)});}
copy('artifacts/chase-review-README.md','README.md');
const shots=['default-rear.png','right-heading-0.00.png','right-heading-1.57.png','safe-exit.png','phone-forward-right.png','phone-reverse-right.png','phone-safe-exit.png'];
for(const [folder,to]of [['vehicle-follow-source','source'],['vehicle-follow-installed','installed'],['vehicle-follow-built','built']]){const r=read('artifacts/'+folder+'/browser.json');assert.equal(r.status,'passed');assert.equal(r.source,head);assert.equal(r.results.length,18);copy('artifacts/'+folder+'/browser.json',to+'/browser.json');for(const file of shots)copy('artifacts/'+folder+'/'+file,to+'/'+file);}
const build=read('dist/package-provenance.json');assert.equal(build.source.commit,head);assert.equal(build.source.dirty,false);copy('dist/package-provenance.json','built/package-provenance.json');copy('artifacts/road-installed/latest.json','installed/package.json');copy('artifacts/steering-before.json','source/steering-before.json');
for(const [file,to]of [['chase-check.log','check.log'],['chase-tests-bounded.log','tests.log'],['chase-tests.log','tests-initial-timeout.log'],['chase-procedural-package-isolated.log','procedural-package-isolated.log'],['chase-upstream.log','upstream.log'],['chase-final-clean-build.log','build.log'],['chase-focused.log','focused.log'],['chase-index.json','index.json']])copy('artifacts/'+file,'gates/'+to);
copy('artifacts/road-yard-review/browser.json','regressions/road.json');copy('artifacts/player-setup-yard-built/browser.json','regressions/trains.json');copy('artifacts/night-ledger-review/browser.json','regressions/night-ledger-browser.json');copy('artifacts/night-ledger-focused/checks.json','regressions/night-ledger-node-types.json');copy('artifacts/night-ledger-installed/latest.json','regressions/night-ledger-installation.json');copy('artifacts/chase-regression-build-source.json','regressions/train-build-source.json');copy('artifacts/chase-candidate-installation.json','regressions/candidate-package.json');copy('artifacts/night-ledger-review-adaptation.json','regressions/night-ledger-harness.json');
assert.equal(read('artifacts/road-yard-review/browser.json').results.length,20);assert.equal(read('artifacts/player-setup-yard-built/browser.json').groups.length,9);assert.equal(read('artifacts/night-ledger-review/browser.json').groups.length,20);assert.equal(read('artifacts/night-ledger-focused/checks.json').tests,23);assert.equal(read('artifacts/night-ledger-installed/latest.json').engineSource.payloadSHA256,installation.engineSource.payloadSHA256);
assert.equal(read('artifacts/chase-cli-process-audit.json').matches.length,0);copy('artifacts/chase-cli-process-audit.json','lifecycle/cli-process-audit.json');copy('artifacts/chase-helper-lifetimes.json','lifecycle/lifetimes.json');copy('artifacts/chase-helper-verification.json','lifecycle/verification.json');
const tracked=new Set(git(['ls-files']).split('\n')),restart=[];for(const file of new Set([...lifetimes.flatMap(r=>r.sourceFiles||[]),'artifacts/collect-chase-helpers.mjs','artifacts/verify-chase-helpers.ps1','artifacts/collect-chase-delivery.mjs'])){if(tracked.has(file))continue;assert.ok(file.startsWith('artifacts/'),file);const full=fs.realpathSync(file);assert.ok(full.startsWith(root+path.sep));const b=fs.readFileSync(full),to='restart/'+sha(b).slice(0,12)+'-'+path.basename(file)+'.original';copy(file,to);restart.push({originalPath:file,preservedPath:to,sha256:sha(b),bytes:b.length});}
save('restart/records.json',{sourceCommit:head,cwd:root,files:restart,helpers:lifetimes.map(r=>({owner:r.owner,purpose:r.purpose,sourceFiles:r.sourceFiles,restart:r.restart})),note:'Stateless completed reviews. Restore preserved scripts to their recorded original artifacts paths, use the recorded source commit/build/package, and deliberately invoke the command. No automatic restart is installed. Versioned source/input closure is preserved by commit and payload identities. Root retained preview is outside this task and is not owned or stopped here.'});
const accepted=['docs/reviews/road-driving/registration.json','packages/player-setup/source.json','packages/player-ui/source.json','packages/native-actors/source.json','packages/vehicle-visuals/profiles.json'].map(file=>{const b=fs.readFileSync(file),old=execFileSync('git',['show',ledger.base+':'+file],{windowsHide:true,maxBuffer:8*1024*1024});assert.ok(b.equals(old),file);return {path:file,bytes:b.length,sha256:sha(b)};});
const report={version:1,status:'finished candidate for Architect review',createdAt:new Date().toISOString(),base:ledger.base,implementationCommit:head,implementationTree:tree,source:installation.engineSource,package:installation.package,allInstalledBytesVerified:true,registration:{path:'registration.json',sha256:sha(fs.readFileSync(base+'registration.json')),files:ledger.files.length},acceptedRecordsUnchanged:accepted,launch:{path:'/examples/vehicle-yard/',query:'',normalClock:true,defaultRearFollowForDriverAndPassenger:true,overviewExplicit:true,previewOwnerAfterApproval:'Architect, Nautilus Engine',retainedBuilderService:false},checks:{gates,sourceFollowGroups:18,installedFollowGroups:18,builtFollowGroups:18,spatialKeyboardHeadings:[0,Math.PI/2],gears:['forward','reverse'],normalClockActualTouchViewport:{width:390,height:844},framingConfigurations:512,installedHeadlessBodies:8,publicTypeNegativeControls:9,existingCarBrowserGroups:20,realTrainCircuits:2,trainBrowserGroups:9,nightLedgerNodeTests:23,nightLedgerBrowserGroups:20},regressionIdentity:{source:'Precommit candidate explicitly labelled with synthetic fixture content; actual full payload equals the final fixed package.',candidateCommit:candidate.engineSource.commit,candidateDirty:candidate.engineSource.dirty,payloadSHA256:installation.engineSource.payloadSHA256,files:555},helpers:{owner:'01a1810c-62da-7210-a1ca-b72b449ce024',recordedLifetimes:lifetimes.length,originalIdentitiesExited:true,originalListenersAbsent:true,retained:0},limits:['Default chase uses a perspective surface; explicit retained camera/HUD providers keep their own policy.','Unchanged flat low-speed bicycle model and conservative collision policy; no new terrain, crash, tire/suspension, resource or game-adoption capability.','Phone tests are browser viewport/touch emulation; no physical-device timing or FPS claim.','Additional spatial cases use explicit public-host starting-pose fixtures; ordinary initial and phone loops use the direct example.'],evidenceHashScope:'Exact normalized LF text and unchanged binary bytes; verify against actual Git index before evidence commit.',evidence};
fs.writeFileSync(base+'delivery.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({status:report.status,implementationCommit:head,evidenceFiles:evidence.length,evidenceBytes:evidence.reduce((n,r)=>n+r.bytes,0),helpers:lifetimes.length}));
