import fs from 'node:fs';import path from 'node:path';
const records=[];for(const entry of fs.readdirSync('artifacts',{withFileTypes:true})){if(!entry.isDirectory()||entry.isSymbolicLink())continue;const folder=path.join('artifacts',entry.name),history=path.join(folder,'helper-history.jsonl');if(!fs.existsSync(history))continue;const receiptPath=path.join(folder,'helper-cleanup-history.jsonl'),receipts=fs.existsSync(receiptPath)?fs.readFileSync(receiptPath,'utf8').trim().split('\n').filter(Boolean).map(JSON.parse):[];for(const r of fs.readFileSync(history,'utf8').trim().split('\n').filter(Boolean).map(JSON.parse)){const receipt=receipts.find(c=>c.process.pid===r.process.pid&&c.process.creationFiletime===r.process.creationFiletime&&c.browser.pid===r.browser.pid&&c.browser.creationFiletime===r.browser.creationFiletime);records.push({folder,...r,receipt:receipt||null});}}
fs.writeFileSync('artifacts/chase-helper-lifetimes.json',JSON.stringify(records,null,2)+'\n');console.log(JSON.stringify({lifetimes:records.length,receipts:records.filter(r=>r.receipt).length,closed:records.filter(r=>r.receipt?.httpClosed&&r.receipt?.browserClosed).length}));
