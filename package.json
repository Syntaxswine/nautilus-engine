{
  "name": "@nautilus-engine/map-core",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Nautilus Engine: shared map authoring and headless character, skill and combat rules",
  "exports": {
    ".": "./packages/map-core/index.js",
    "./prefabs": "./packages/prefab-core/index.js",
    "./rules": "./packages/rules-core/index.js",
    "./rules/dialogue": "./packages/rules-core/dialogue.js",
    "./rules/aft": "./packages/rules-core/aft-compat.js",
    "./render-effects": "./packages/render-effects/index.js",
    "./render-effects/three": "./packages/render-effects/three.js",
    "./buildings": "./packages/building-catalog/index.js",
    "./buildings/three": "./packages/building-catalog/three.js"
  },
  "files": [
    "packages",
    "vendor",
    "docs",
    "upstream.json",
    "NOTICE.md",
    "examples",
    "assets/buildings",
    "art/buildings"
  ],
  "scripts": {
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:upstream": "node tools/test-upstream.mjs",
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "serve:buildings": "node tools/serve-building-library.mjs",
    "build:buildings": "node tools/build-building-assets.mjs",
    "check:buildings": "node tools/check-building-catalog.mjs",
    "review:buildings": "node tools/review-building-catalog.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
