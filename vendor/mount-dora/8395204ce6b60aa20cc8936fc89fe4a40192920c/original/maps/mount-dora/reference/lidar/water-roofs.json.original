{
 "kind": "mount-dora-lidar-water-roofs",
 "version": 4,
 "inputs": {
  "features": {
   "file": "maps/mount-dora/features.json",
   "sha256OfFieldsRead": "facf21e6262a1f37be37b79c2b2818919c7937783d488db7e106de16732a5215",
   "fields": "OSM-sourced features only: id, category, tags, geographicGeometry (else geometry); nativeSectors for buildings; authoredStructures ids and geographicGeometry (else geometry)"
  },
  "lidar": {
   "file": "maps/mount-dora/reference/lidar/source.json",
   "sha256": "e9712f29c3b1f637e8c1742a95ed40f0321748e023b9b7fed8d2dda664586e4f"
  }
 },
 "policy": "Public-domain USGS 3DEP lidar, flown in December 2018. Roofs the lidar sees on Lake Dora where no OpenStreetMap or county outline exists: boathouses and covered slips. The art kit draws each piece as a roof on posts; walls, if any, are unknown.",
 "collection": {
  "dataset": "FL_Peninsular_Lake_2018",
  "acquired": [
   "2018-12-06",
   "2018-12-06"
  ]
 },
 "method": {
  "rules": {
   "cellM": 0.5,
   "minAreaM2": 6,
   "lakeReachM2": 1,
   "drawnShareMax": 0.25,
   "drawnMarginM": 1,
   "pieceMinM2": 6,
   "pieceMinWidthM": 1.5,
   "pieceLakeMin": 0.5,
   "ringM": 3,
   "ringReadMin": 0.5,
   "ringWaterMin": 0.75,
   "lowM": 1.5,
   "dockReachM": 3,
   "joinM": 0.74,
   "barBand": 0.05
  },
  "roofs": "Building (class 6) returns, moved into the town frame by the outline registration (-0.04, 0.84) m and binned in 0.5 m cells; two cells join into one roof, over land and water alike, where some return of one lies within 0.74 m of some return of the other (cells up to two apart are compared, so a roof is its returns' own cluster at that distance, wherever the grid falls). A roof is kept when at least 1 m² of it lies in Lake Dora's OSM outline, and at most 25% of it inside an outline the game draws (OSM and county buildings, the generator's structures). A roof joined to a drawn one beyond that share is that building's own (a wing, a porch, an attached boathouse its county sketch leaves out) and is not kept.",
  "outline": "Cells within 1 m of a drawn outline are left to it. The rest of a roof splits into parts that join eight ways; a part of 6 m² or more is outlined by rectangles in its own frame (pieces): the smallest rectangle around it, unless that roofs over an open rectangle of 6 m², 1.5 m wide, its cells (closed by a 3 x 3 square) do not fill; otherwise the largest rectangles its cells fill, one after another, in the frame where the largest is biggest, while one of that size remains. A piece stands over water where 50% of it lies in the lake's outline, or where the lidar sees water around it: 50% of the cells within 3 m read as water or ground (no roof over them; the cells under the piece's own roof are no part of its ring) and 75% of those read as water (water returns, or no return at all: calm water returns none). A dock or reeds in the water read as water too: a cell within 3 m of such water, with no ground return (classes 2 and 20) and most of its returns between half a metre under the lake's level and 1.5 m over it. The rest are left out: 'not over water' where what is read of the ring is not water, 'too little read around it' where it is water but under 50% of the ring is read, or nothing is read. The pieces kept form groups, joined where their returns lie within 0.74 m of one another; a group under half in the lake's outline by area that touches a piece left out as not over water is part of what stands on land, and is left out with it, recording the group's share (groupLakeShare) and how many such pieces it touched (landTouched); a group that touches one and stays records its share on each of its pieces. Each roof counts the pieces it leaves out on land (onLand: not over water, or with such a group) apart from those too little read (unread). All are listed in leftOut with their measures. Parts under 6 m², a part's cells no piece covers, and roofs left with none, go without a record. nearBar lists, for each piece and record, the measures within 0.05 of their bar that decide it (moved across the bar alone, they would keep it, leave it out, or change why): shares counted in grid cells, which may fall either way as the grid or the registration moves.",
  "heights": "Per piece, from its own returns, in metres above the lake's lidar level: the eave from the roof planes as in lidar-roofs.json (the 25th percentile where none is found), the ridge at the 98th percentile; form and pitch by the same rules (roofs.mjs)."
 },
