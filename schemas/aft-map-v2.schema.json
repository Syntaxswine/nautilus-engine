{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nautilus:schema:map:2",
  "title": "Nautilus inherited portable map v2 structural contract",
  "type": "object",
  "required": [
    "version",
    "width",
    "height",
    "levels",
    "name",
    "terrain",
    "upper",
    "edges",
    "stairs",
    "props",
    "starts",
    "guards",
    "exits"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "width": {
      "const": 240
    },
    "height": {
      "const": 240
    },
    "levels": {
      "type": "integer",
      "minimum": 3,
      "maximum": 6
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "terrain": {
      "type": "array",
      "minItems": 240,
      "maxItems": 240,
      "items": {
        "type": "array",
        "minItems": 240,
        "maxItems": 240,
        "items": {
          "type": "string"
        }
      }
    },
    "upper": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stairs": {
      "type": "array"
    },
    "props": {
      "type": "array"
    },
    "starts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "guards": {
      "type": "array",
      "maxItems": 46
    },
    "exits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    },
    "wallRuns": {
      "type": "object",
      "required": [
        "version",
        "segments"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "segments": {
          "type": "array",
          "maxItems": 4096
        }
      }
    },
    "buildingPrefabs": {
      "type": "object",
      "required": [
        "version",
        "catalogue",
        "instances"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "catalogue": {
          "type": "string"
        },
        "instances": {
          "type": "array",
          "maxItems": 32
        }
      }
    },
    "slopedRoofs": {
      "type": "object",
      "required": [
        "version",
        "roofs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "roofs": {
          "type": "array"
        }
      }
    }
  },
  "additionalProperties": true,
  "$comment": "This structural schema does not replace loadBlueprint geometry, content, extension and connectivity checks. Unknown JSON data remains opaque; required behavior needs a capability."
}
