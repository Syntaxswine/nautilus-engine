{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nautilus:schema:railway-routes:6",
  "title": "Nautilus railway with explicit train and curve sizes",
  "type": "object",
  "required": ["version", "routes", "trains"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 6},
    "routes": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "required": ["id", "waypoints"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
          "waypoints": {"$ref": "urn:nautilus:schema:railway-routes:1#/properties/routes/items/properties/waypoints"},
          "turnout": {"$ref": "urn:nautilus:schema:railway-routes:2#/properties/routes/items/properties/turnout"},
          "radiusM": {"enum": [4, 16]}
        }
      }
    },
    "trains": {
      "type": "array", "minItems": 0, "maxItems": 2,
      "items": {
        "type": "object", "required": ["routeId", "stock", "departure", "switchPosition"], "additionalProperties": false,
        "properties": {
          "routeId": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
          "stock": {"enum": ["steam", "electric"]},
          "departure": {"enum": ["start", "end", "branch"]},
          "switchPosition": {"enum": ["main", "branch"]},
          "profile": {"enum": ["miniature", "world"]}
        }
      }
    }
  },
  "$comment": "Missing profile and radius retain miniature proportions. World-size trains require 16m routes. Departure fit, unique stock, clear ground and safe separation are validated by map-core. Runtime poses are not saved."
}
