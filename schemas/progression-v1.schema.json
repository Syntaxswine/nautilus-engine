        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hp",
            "ap",
            "stamina"
          ],
          "properties": {
            "hp": {
              "type": "number",
              "minimum": 0,
              "maximum": 150
            },
            "ap": {
              "type": "number",
              "minimum": 0,
              "maximum": 18
            },
            "stamina": {
