          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "expectedRevision",
            "type",
            "allocation"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "type": {
              "const": "allocate"
            },
