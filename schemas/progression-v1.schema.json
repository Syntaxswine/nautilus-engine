{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nautilus:schema:progression:1",
  "title": "Nautilus basic character progression bundle version 1",
  "description": "Structural validation only. openProgression additionally validates the complete command/receipt journal, profile arithmetic, character resource limits and duplicate identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "profileId",
    "character",
    "baseline",
    "level",
    "xp",
    "practice",
    "revision",
    "receipts"
  ],
  "properties": {
    "kind": {
      "const": "nautilus-basic-progression"
    },
    "version": {
      "const": 1
    },
    "profileId": {
      "const": "basic-progression-v1"
    },
    "character": {
      "$ref": "#/$defs/character"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stats",
        "skillPoints"
      ],
      "properties": {
        "stats": {
          "$ref": "#/$defs/stats"
        },
        "skillPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "xp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "practice": {
      "$ref": "#/$defs/practice"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "receipts": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    }
  },
