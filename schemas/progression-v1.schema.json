    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "expectedRevision",
            "type",
            "source",
            "sourceId",
            "amount"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "type": {
              "const": "xp"
            },
            "source": {
              "enum": [
                "kill",
                "objective"
              ]
            },
            "sourceId": {
              "$ref": "#/$defs/identifier"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "expectedRevision",
            "type",
            "source",
            "sourceId",
            "amount",
            "stat"
          ],
          "properties": {
