{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nautilus:schema:railway-routes:2",
  "title": "Nautilus ground railway routes with splits",
  "type": "object",
  "required": ["version", "routes"],
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 239}
    }
  },
  "properties": {
    "version": {"const": 2},
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "contains": {"type": "object", "required": ["turnout"]},
      "items": {
        "type": "object",
        "required": ["id", "waypoints"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
          "waypoints": {"type": "array", "minItems": 2, "maxItems": 48, "items": {"$ref": "#/$defs/point"}},
          "turnout": {
            "type": "object",
            "required": ["at", "end"],
            "additionalProperties": false,
            "properties": {
              "at": {"$ref": "#/$defs/point"},
              "end": {"$ref": "#/$defs/point"}
            }
          }
        }
      }
    }
  },
  "$comment": "The headless planner validates the fitted main line, the 45 degree branch and shared clearance."
}
