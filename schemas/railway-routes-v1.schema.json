{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nautilus:schema:railway-routes:1",
  "title": "Nautilus ground railway routes",
  "type": "object",
  "required": ["version", "routes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "waypoints"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
          "waypoints": {
            "type": "array",
            "minItems": 2,
            "maxItems": 48,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "integer", "minimum": 0, "maximum": 239}
            }
          }
        }
      }
    }
  },
  "$comment": "The headless route planner validates headings, radius, approach length, route separation and ground clearance."
}
