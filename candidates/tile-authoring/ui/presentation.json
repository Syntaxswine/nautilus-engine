{
  "kind": "nautilus-tile-authoring-ui-c0-design",
  "version": 1,
  "status": "contract-design-only",
  "coreCommit": "43227894c50ec62b71806978195fff2c650eb388",
  "schemaId": "urn:nautilus:candidate:tile-authoring:core:1",
  "canonicalDiscovery": "inputs/core-discovery.json",
  "canonicalSchema": "inputs/core-c0.schema.json",
  "runtimeImplemented": false,
  "service": {
    "type": "HostService",
    "source": "inputs/core-api.d.ts",
    "methods": [
      "describe",
      "snapshot",
      "query",
      "prepare",
      "apply",
      "cancel",
      "recover"
    ],
    "sameHumanAgentConnection": true,
    "authorityOwner": "Editor",
    "presentationNeverMintsPermission": true
  },
  "flow": {
    "Stage": "Collect one finite canonical Command in the existing Editor-owned draft. No prepare/write. Draft collector signature is Editor-owned, not a new Core command.",
    "Review": "Call service.prepare(command) once. The Editor connection retains the actual result and authority.",
    "Apply": "Forward the same Editor-retained canonical Apply request. No second prepare or target-digest re-creation.",
    "queries": "Use service.query(Query). Requirements and export-plan queries have no Apply/history.",
    "unknown": "committed:null freezes writes/overwrite saves; retain potentially adopted resources and recover original requestId.",
    "noChange": "NO_CHANGE makes no write/history entry and preserves redo.",
    "metadataOnly": "Exact tileBundle/layout revision/constraints stay unchanged; tilePreparation is source-unchanged.",
    "history": "Restore exact full historical document/contentRevision. Freshness comes from checkpoint/journal/context tokens, not a monotonic revision."
  },
  "defaults": {
    "paintScope": "placed-instance",
    "includeSelectedDecorationDefaults": false,
    "selectedCaptureMarkIds": [],
    "placedCopiesFollowNewLibraryRevisions": false,
    "upgradeRequiresExplicitOwnerIds": true
  },
