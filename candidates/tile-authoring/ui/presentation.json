  "resources": {
    "bytesInFiniteCommand": false,
    "bulkStaging": "Verified bytes/decoder leases use host ports outside operations[]",
    "adoption": "References adopted with the same complete targetDocument/history/recovery",
    "descriptor": "One immutable library artwork record; resourceRefs only exact artwork pin + imageViewDigest",
    "requiredDecoder": "image/png",
    "optionalUnboundDecoder": "image/webp",
    "imageView": "#/$defs/imageView",
    "sampler": "#/$defs/imageSampler",
    "tint": "tintLinearRGB",
    "layerBlend": "source-over-linear-premultiplied-v1",
    "layerOpacity": "Composite ordered marks then attenuate the group"
  },
  "coordinates": {
    "status": "fixed-core-coordinate-contract",
    "sourceCommit": "43227894c50ec62b71806978195fff2c650eb388",
    "storedImageUV": "top-left",
    "storedPivotUV": "top-left",
    "imageToLocal": "position + R * [mirrorSign*(u_i-p_u)*width, (p_v-v_i)*height]",
    "then": "Surface.originM + Surface.axes basis, current owner D4 + origin once, native [x,y,h] -> render [x,h,y] once",
    "pixelY": "frame.y + v_i*height - 0.5",
    "localUpAlternative": "Only with pivotV_up=1-p_v; no implicit pivot conversion.",
    "proofScope": "Core mathematical vectors only; no decoder/renderer/runtime implementation."
  },
  "proposedLimits": {
