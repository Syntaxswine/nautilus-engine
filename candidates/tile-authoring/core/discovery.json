      "schemaPointer": "#/$defs/operation",
      "effectDomain": "content-and-explicit-placement"
    },
    {
      "name": "preset.place",
      "schemaPointer": "#/$defs/operation",
      "effectDomain": "content-and-explicit-placement"
    },
    {
      "name": "placement.upgrade",
      "schemaPointer": "#/$defs/operation",
      "effectDomain": "content-and-explicit-placement"
    },
    {
      "name": "owner.remove",
      "schemaPointer": "#/$defs/operation",
      "effectDomain": "content-and-explicit-placement"
    },
    {
      "name": "decoration.add",
